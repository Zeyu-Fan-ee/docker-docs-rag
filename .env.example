# Copy values into your existing .env; never commit real credentials.
MODEL_ID=
API_KEY=
BASE_URL=
MODEL_DEVICE=cpu
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_MAX_LENGTH=512
CHUNK_METHOD=semantic
CHUNK_SIZE=650
CHUNK_OVERLAP=100
TOP_K=10
FINAL_K=3
USE_RERANKER=true
DB_PATH=chroma_db_docker
COLLECTION_NAME=docker_documentation
API_URL=http://127.0.0.1:8000
# Evaluation judge deliberately has independent settings.
JUDGE_MODEL_ID=
JUDGE_API_KEY=
JUDGE_BASE_URL=
RAGAS_DO_NOT_TRACK=true
